## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
[Bb]in/
[Oo]bj/

# Visual Studio files
.vs/
*.user
*.suo
*.userprefs
*.usertasks

# Test results
TestResults/
*.trx

# Mac stuff
.DS_Store

# Godot stuff (temporary)
.godot/
*.tmp